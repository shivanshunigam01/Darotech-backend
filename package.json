{
  "name": "darotech-backend",
  "version": "1.0.0",
  "description": "Fully-fledged Node Express MongoDB backend for Darotech website and admin dashboard",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seedDatabase.js",
    "test:api": "node scripts/api-integration-test.mjs",
    "lint": "eslint src --ext .js"
  },
  "dependencies": {
    "bcryptjs": "latest",
    "compression": "latest",
    "cookie-parser": "latest",
    "cors": "latest",
