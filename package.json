    "express-rate-limit": "latest",
    "helmet": "latest",
    "jsonwebtoken": "latest",
    "json2csv": "latest",
    "mongoose": "latest",
    "morgan": "latest",
    "multer": "latest",
    "node-cron": "latest",
    "nodemailer": "latest",
    "pdfkit": "latest",
    "razorpay": "latest",
    "slugify": "latest",
    "stripe": "latest",
    "winston": "latest",
    "zod": "latest"
