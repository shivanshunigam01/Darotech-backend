NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-frontend.vercel.app,http://localhost:5173

# Required on Vercel — Project → Settings → Environment Variables
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/darotech
JWT_ACCESS_SECRET=change-this-access-secret
JWT_REFRESH_SECRET=change-this-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Optional
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
UPLOAD_DIR=/tmp/uploads
